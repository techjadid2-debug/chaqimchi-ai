# Chaqimchi AI — muhit o‘zgaruvchilari (namuna)
# Nusxa: cp .env.example .env

# Lokal production deploy (maxfiy SSH kalitning o'zi emas, faqat yo'li).
# CHAQIMCHI_DEPLOY_URL=https://chaqimchi.example.uz
# CHAQIMCHI_DEPLOY_SSH_HOST=203.0.113.10
# CHAQIMCHI_DEPLOY_SSH_USER=deploy
# CHAQIMCHI_DEPLOY_SSH_TARGET=deploy@203.0.113.10
# CHAQIMCHI_DEPLOY_SSH_KEY=/absolute/path/to/.deploy_keys/production
# CHAQIMCHI_DEPLOY_PROJECT_DIR=/home/deploy/chaqimchi-ai
# CHAQIMCHI_DEPLOY_ENV_FILE=.env.production
# CHAQIMCHI_DEPLOY_COMPOSE_FILE=docker-compose.contabo.yml
# CHAQIMCHI_DEPLOY_BACKUP_DIR=/home/deploy/chaqimchi-backups

# Konfiguratsiya yo‘li (ixtiyoriy)
# CHAQIMCHI_CONFIG=/absolute/path/config/config.yaml

# API kalit (security.api_key_enabled=true bo‘lsa)
# CHAQIMCHI_API_KEY=your-secret-key

# JWT (security.jwt.enabled=true)
# CHAQIMCHI_JWT_SECRET=your-jwt-secret-min-32-chars

# Embedding shifrlash (storage.encrypt_embeddings=true)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHAQIMCHI_EMBEDDING_KEY=

# Vision Agent — key faqat cloud/vision-worker konteynerida ishlaydi.
# Har filial egasi panelda alohida rozilik bermaguncha media Gemini'ga yuborilmaydi.
# Aniq stable model nomlarini kiriting; `latest` yoki eski 1.5 alias ishlatmang.
# CHAQIMCHI_GEMINI_API_KEY=
# CHAQIMCHI_GEMINI_VISION_MODEL=
# CHAQIMCHI_GEMINI_FALLBACK_MODEL=
# Native audio javobi ixtiyoriy; model qo'llamasa matnli javob saqlanadi.
# CHAQIMCHI_GEMINI_NATIVE_AUDIO_MODEL=

# Cloud admin (markaz server)
# CHAQIMCHI_CLOUD_ADMIN_KEY=
# CHAQIMCHI_CLOUD_URL=http://127.0.0.1:8750
# CHAQIMCHI_UI_V2=1
# Login/parolli admin/o'rnatuvchi/mijoz portali. Bo'sh bo'lsa owner JWT secret ishlatiladi.
# CHAQIMCHI_PORTAL_JWT_SECRET=your-portal-jwt-secret-min-32-chars
# CHAQIMCHI_BOOTSTRAP_ADMIN_USERNAME=admin
# CHAQIMCHI_BOOTSTRAP_ADMIN_PASSWORD=one-time-strong-password

# Cloud ogohlantirishi — mijoz tizimi o‘chsa Telegramga xabar
# Bot: @BotFather → /newbot
# CHAQIMCHI_CLOUD_TELEGRAM_TOKEN=
# CHAQIMCHI_CLOUD_TELEGRAM_CHAT_ID=
# Public ro'yxatdan o'tish deep-linki uchun tokensiz bot username.
# CHAQIMCHI_TELEGRAM_BOT_USERNAME=chaqimchi_bot
# Leadlar faqat shu shaxsiy ID ro'yxatiga yuboriladi.
# CHAQIMCHI_TELEGRAM_LEAD_CHAT_IDS=5476913898
# CHAQIMCHI_TELEGRAM_WEBHOOK_SECRET=
# CHAQIMCHI_CLOUD_ALERT_INTERVAL_SEC=900

# To'lov (docs/TOLOV.md) — to'lov havolalari ochiladigan tashqi HTTPS manzil
# CHAQIMCHI_PUBLIC_URL=https://cloud.example.uz

# Payme merchant kabinetidan
# CHAQIMCHI_PAYME_MERCHANT_ID=
# CHAQIMCHI_PAYME_KEY=

# Click SHOP-API
# CHAQIMCHI_CLICK_SERVICE_ID=
# CHAQIMCHI_CLICK_MERCHANT_ID=
# CHAQIMCHI_CLICK_SECRET=

# Matplotlib kesh (ixtiyoriy, CI/docker uchun)
# MPLCONFIGDIR=/tmp/matplotlib

# Moliya paneli (admin → Moliya) — batafsil .env.production.example da.
# CHAQIMCHI_COST_SERVER_MONTHLY_USD=0
# CHAQIMCHI_COST_DOMAIN_YEARLY_UZS=27000
