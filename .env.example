# ENES Monitoring — muhit o‘zgaruvchilari (namuna)
# Nusxa: cp .env.example .env

# Lokal production deploy (maxfiy SSH kalitning o'zi emas, faqat yo'li).
# ENES_DEPLOY_URL=https://enes.example.uz
# ENES_DEPLOY_SSH_HOST=203.0.113.10
# ENES_DEPLOY_SSH_USER=deploy
# ENES_DEPLOY_SSH_TARGET=deploy@203.0.113.10
# ENES_DEPLOY_SSH_KEY=/absolute/path/to/.deploy_keys/production
# ENES_DEPLOY_PROJECT_DIR=/home/deploy/enes
# ENES_DEPLOY_ENV_FILE=.env.production
# ENES_DEPLOY_COMPOSE_FILE=docker-compose.contabo.yml
# ENES_DEPLOY_BACKUP_DIR=/home/deploy/enes-backups

# Konfiguratsiya yo‘li (ixtiyoriy)
# ENES_CONFIG=/absolute/path/config/config.yaml

# API kalit (security.api_key_enabled=true bo‘lsa)
# ENES_API_KEY=your-secret-key

# JWT (security.jwt.enabled=true)
# ENES_JWT_SECRET=your-jwt-secret-min-32-chars

# Embedding shifrlash (storage.encrypt_embeddings=true)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENES_EMBEDDING_KEY=

# Vision Agent — key faqat cloud/vision-worker konteynerida ishlaydi.
# Har filial egasi panelda alohida rozilik bermaguncha media Gemini'ga yuborilmaydi.
# Aniq stable model nomlarini kiriting; `latest` yoki eski 1.5 alias ishlatmang.
# ENES_GEMINI_API_KEY=
# ENES_GEMINI_VISION_MODEL=
# ENES_GEMINI_FALLBACK_MODEL=
# Native audio javobi ixtiyoriy; model qo'llamasa matnli javob saqlanadi.
# ENES_GEMINI_NATIVE_AUDIO_MODEL=

# Cloud admin (markaz server)
# ENES_CLOUD_ADMIN_KEY=
# ENES_CLOUD_URL=http://127.0.0.1:8750
# ENES_UI_V2=1
# Login/parolli admin/o'rnatuvchi/mijoz portali. Bo'sh bo'lsa owner JWT secret ishlatiladi.
# ENES_PORTAL_JWT_SECRET=your-portal-jwt-secret-min-32-chars
# ENES_BOOTSTRAP_ADMIN_USERNAME=admin
# ENES_BOOTSTRAP_ADMIN_PASSWORD=one-time-strong-password

# Cloud ogohlantirishi — mijoz tizimi o‘chsa Telegramga xabar
# Bot: @BotFather → /newbot
# ENES_CLOUD_TELEGRAM_TOKEN=
# ENES_CLOUD_TELEGRAM_CHAT_ID=
# Public ro'yxatdan o'tish deep-linki uchun tokensiz bot username.
# ENES_TELEGRAM_BOT_USERNAME=enes_bot
# Leadlar faqat shu shaxsiy ID ro'yxatiga yuboriladi.
# ENES_TELEGRAM_LEAD_CHAT_IDS=5476913898
# ENES_TELEGRAM_WEBHOOK_SECRET=
# ENES_CLOUD_ALERT_INTERVAL_SEC=900

# To'lov (docs/TOLOV.md) — to'lov havolalari ochiladigan tashqi HTTPS manzil
# ENES_PUBLIC_URL=https://cloud.example.uz

# Payme merchant kabinetidan
# ENES_PAYME_MERCHANT_ID=
# ENES_PAYME_KEY=

# Click SHOP-API
# ENES_CLICK_SERVICE_ID=
# ENES_CLICK_MERCHANT_ID=
# ENES_CLICK_SECRET=

# Matplotlib kesh (ixtiyoriy, CI/docker uchun)
# MPLCONFIGDIR=/tmp/matplotlib

# Moliya paneli (admin → Moliya) — batafsil .env.production.example da.
# ENES_COST_SERVER_MONTHLY_USD=0
# ENES_COST_DOMAIN_YEARLY_UZS=27000
