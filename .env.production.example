# Bu fayl namuna. Haqiqiy qiymatlarni `.env.production` ga yozing; u gitignore'da.
ENES_ENV=production
# V2 React owner/admin paneli. 0 — legacy rollback, 1 — yangi UI.
ENES_UI_V2=0
ENES_DOMAIN=chaqimchi.uz
ENES_PUBLIC_URL=https://chaqimchi.uz
# Subdomen platformasi (deploy/Caddyfile.enes bilan birga ishlaydi).
# Berilmasa hamma bo'lim bitta PUBLIC_URL da qoladi (eski rejim).
ENES_APP_URL=https://app.chaqimchi.uz
ENES_API_URL=https://api.chaqimchi.uz
ENES_DL_URL=https://dl.chaqimchi.uz
ENES_PARTNER_URL=https://partner.chaqimchi.uz
ENES_ADMIN_URL=https://admin.chaqimchi.uz
# Sotqin platforma bazasi va USD AI narxlarini UZS invoice'ga aylantirish kursi.
# Kurs o'zgarsa faqat yangi invoice'lar yangi summada ochiladi.
ENES_USD_RATE_UZS=13000

POSTGRES_DB=enes
POSTGRES_USER=enes
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://enes:GENERATE_A_LONG_RANDOM_PASSWORD@postgres:5432/enes

MINIO_ROOT_USER=GENERATE_ACCESS_KEY
MINIO_ROOT_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
ENES_S3_ENDPOINT=http://minio:9000
ENES_S3_ACCESS_KEY=GENERATE_ACCESS_KEY
ENES_S3_SECRET_KEY=GENERATE_A_LONG_RANDOM_PASSWORD
ENES_S3_BUCKET=enes-snapshots
ENES_SNAPSHOT_KEY=GENERATE_WITH_FERNET
# RTSP/NVR loginlari cloud DBda faqat shu Fernet kaliti bilan shifrlanadi.
ENES_CAMERA_SECRET_KEY=GENERATE_WITH_FERNET
# Rasmiy Sotqin release nashr qilinganda deploy pipeline ushbu ikkisini yangilaydi.
# Ikki bot ataylab alohida:
#   ENES_OWNER_TELEGRAM_TOKEN — MIJOZ boti (hisobot, alert, /kamera)
#   ENES_SALES_TELEGRAM_TOKEN — SOTUV boti (saytdan kelgan arizalar va
#     servis ogohlantirishlari sizga shu botdan keladi; berilmasa mijoz
#     boti ishlatiladi va ikkalasi bitta chatda aralashadi)
ENES_SALES_TELEGRAM_TOKEN=BOTFATHER_TOKEN
ENES_SOTQIN_RELEASE_URL=https://ai.example.uz/releases/enes-sotqin-0.5.0.tar.gz
ENES_SOTQIN_RELEASE_SHA256=64_CHARACTER_LOWERCASE_SHA256

# Windows o'rnatuvchisi (~70 MB).  U Docker image ichida tashilmaydi —
# GitHub Releases'da turadi va cloud faqat yo'naltiradi.  Berilmasa sayt
# yuklab olish tugmasi o'rniga "tayyor bo'lganda xabar bering" formasini
# ko'rsatadi, ya'ni mijoz buzuq tugmani bosmaydi.  Havola HTTPS bo'lishi shart.
ENES_WINDOWS_INSTALLER_URL=https://github.com/OWNER/REPO/releases/download/vX.Y.Z/ENES_Setup.exe
ENES_WINDOWS_INSTALLER_SIZE_MB=68

ENES_CLOUD_ADMIN_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENES_OWNER_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Login/parolli admin, o'rnatuvchi va mijoz tokenlari uchun alohida secret.
ENES_PORTAL_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Faqat birinchi ishga tushirishda ixtiyoriy. Admin yaratilgach bu ikki satrni o'chiring.
# ENES_BOOTSTRAP_ADMIN_USERNAME=admin
# ENES_BOOTSTRAP_ADMIN_PASSWORD=GENERATE_A_STRONG_ONE_TIME_PASSWORD
# Bitta BotFather tokeni owner OTP/buyruqlari va service alertlari uchun yetadi.
ENES_OWNER_TELEGRAM_TOKEN=FROM_BOTFATHER
ENES_TELEGRAM_BOT_USERNAME=enes_bot
ENES_TELEGRAM_WEBHOOK_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENES_CLOUD_TELEGRAM_CHAT_ID=SERVICE_ADMIN_CHAT_ID
# Maslahat/tarif arizalari faqat shu shaxsiy ID'larga boradi.
ENES_TELEGRAM_LEAD_CHAT_IDS=5476913898
# Public do'kon funksiyalari faqat quyidagi qabul fayli haqiqiy bo'lsa ochiladi.
ENES_N100_ACCEPTANCE_FILE=/opt/enes/acceptance/n100-r1.json
ENES_AVAILABLE_FEATURES=person_count,queue_length,store_security

# Sotqin qurilmasining env'i bu cloud fayliga yozilmaydi.
# Canonical namuna: deploy/sotqin.env.example.

# ── Vision Agent (Gemini) ────────────────────────────────────────────────
# Kalit faqat cloud/vision-worker konteynerlarida ishlaydi.  Har filial
# egasi panelda alohida rozilik bermaguncha media Gemini'ga yuborilmaydi.
# IKKALASI ham shart: kalit bo'lib model nomi bo'sh qolsa agent ishlamaydi.
# Aniq stable model nomini yozing; `latest` yoki eski 1.5 alias ishlatmang.
ENES_GEMINI_API_KEY=
ENES_GEMINI_VISION_MODEL=
# Ixtiyoriy: asosiy model xatosida sinaladigan zaxira model.
# ENES_GEMINI_FALLBACK_MODEL=
# Ixtiyoriy: ovozli javob modeli; qo'llamasa matn javob saqlanadi.
# ENES_GEMINI_NATIVE_AUDIO_MODEL=

# ── Panel versiyalari ────────────────────────────────────────────────────
# Owner va admin paneli ALOHIDA yoqiladi: onboarding (qurilma ulash,
# kamera qo'shish, chiziq chizish) faqat yangi (v2) owner panelida bor;
# support vositalari (masofadan chiziq chizish, diagnostika) hozircha
# legacy adminda.  ENES_UI_V2 eski umumiy flag — fallback.
ENES_UI_V2_OWNER=1
ENES_UI_V2_ADMIN=0

# ── Media saqlash muddatlari ─────────────────────────────────────────────
# Klip retention kunlarda; berilmasa 7. Tarif va'dasi (30/90/365) bilan
# moslang yoki saytdagi va'dani kamaytiring — ikkisi farq qilsa mijoz
# to'lagan arxivini olmaydi.
# ENES_CLIP_RETENTION_DAYS=30
# Yuz kadrlari retentioni (kun); berilmasa 14.
# ENES_FACE_RETENTION_DAYS=14
# Sayt boshiga media kvota (bayt); berilmasa 10 GB.
# ENES_SITE_MEDIA_MAX_BYTES=10737418240

# Tashqi installer URL ishlatilganda saytdagi versiya belgisi shu yerdan
# olinadi (bo'lmasa lokal relizdan). Cloud image versiyasi EMAS.
# ENES_WINDOWS_INSTALLER_VERSION=0.6.13

# ── Moliya paneli (admin → Moliya) ──────────────────────────────────────
# Server ijarasi oyiga (USD) — Contabo hisobidagi haqiqiy summani yozing.
# 0 qolsa panel "kiritilmagan" deb ogohlantiradi.
ENES_COST_SERVER_MONTHLY_USD=0
# Domen yillik narxi (so'm). Oyiga bo'lib ko'rsatiladi.
ENES_COST_DOMAIN_YEARLY_UZS=27000
# Gemini narxlari, 1 mln token uchun USD (Google narxni o'zgartirsa yangilang).
# Token SARFI haqiqiy (Google javobidan yoziladi), bu faqat tarif.
# ENES_GEMINI_INPUT_USD_PER_M=0.30
# ENES_GEMINI_OUTPUT_USD_PER_M=2.50
