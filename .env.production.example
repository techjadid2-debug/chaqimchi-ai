# Bu fayl namuna. Haqiqiy qiymatlarni `.env.production` ga yozing; u gitignore'da.
CHAQIMCHI_ENV=production
CHAQIMCHI_DOMAIN=ai.example.uz
CHAQIMCHI_PUBLIC_URL=https://ai.example.uz
# Sotqin platforma bazasi va USD AI narxlarini UZS invoice'ga aylantirish kursi.
# Kurs o'zgarsa faqat yangi invoice'lar yangi summada ochiladi.
CHAQIMCHI_USD_RATE_UZS=13000

POSTGRES_DB=chaqimchi
POSTGRES_USER=chaqimchi
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://chaqimchi:GENERATE_A_LONG_RANDOM_PASSWORD@postgres:5432/chaqimchi

MINIO_ROOT_USER=GENERATE_ACCESS_KEY
MINIO_ROOT_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
CHAQIMCHI_S3_ENDPOINT=http://minio:9000
CHAQIMCHI_S3_ACCESS_KEY=GENERATE_ACCESS_KEY
CHAQIMCHI_S3_SECRET_KEY=GENERATE_A_LONG_RANDOM_PASSWORD
CHAQIMCHI_S3_BUCKET=chaqimchi-snapshots
CHAQIMCHI_SNAPSHOT_KEY=GENERATE_WITH_FERNET
# RTSP/NVR loginlari cloud DBda faqat shu Fernet kaliti bilan shifrlanadi.
CHAQIMCHI_CAMERA_SECRET_KEY=GENERATE_WITH_FERNET
# Rasmiy Sotqin release nashr qilinganda deploy pipeline ushbu ikkisini yangilaydi.
CHAQIMCHI_SOTQIN_RELEASE_URL=https://ai.example.uz/releases/sotqin-0.4.0.tar.gz
CHAQIMCHI_SOTQIN_RELEASE_SHA256=64_CHARACTER_LOWERCASE_SHA256

CHAQIMCHI_CLOUD_ADMIN_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CHAQIMCHI_OWNER_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Bitta BotFather tokeni owner OTP/buyruqlari va service alertlari uchun yetadi.
CHAQIMCHI_OWNER_TELEGRAM_TOKEN=FROM_BOTFATHER
CHAQIMCHI_TELEGRAM_WEBHOOK_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CHAQIMCHI_CLOUD_TELEGRAM_CHAT_ID=SERVICE_ADMIN_CHAT_ID
# Maslahat/tarif arizalari boradigan qo'shimcha shaxsiy va guruh ID'lari.
# Guruh ID'sini ham verguldan keyin yozish mumkin: 5476913898,-1001234567890
CHAQIMCHI_TELEGRAM_LEAD_CHAT_IDS=5476913898
# true bo'lsa bot qo'shilgan ichki sales guruhi ham yangi leadlarni oladi.
# Botni faqat ishonchli ichki guruhlarga qo'shing.
CHAQIMCHI_TELEGRAM_AUTO_GROUP_LEADS=true
# Public do'kon funksiyalari faqat quyidagi qabul fayli haqiqiy bo'lsa ochiladi.
CHAQIMCHI_N100_ACCEPTANCE_FILE=/opt/chaqimchi/acceptance/n100-r1.json
CHAQIMCHI_AVAILABLE_FEATURES=person_count,queue_length,store_security

# Sotqin qurilmasining env'i bu cloud fayliga yozilmaydi.
# Canonical namuna: deploy/sotqin.env.example.
