.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
# Reliz artefaktlari git'da saqlanmaydi — ular CI'da quriladi va GitHub
# Releases'ga yuklanadi.  O'rnatuvchi .exe ichida Python va AI modellari bor,
# ya'ni ~150 MB: bunday binarni har build'da commit qilish repo tarixini
# qaytarib bo'lmas darajada shishiradi.
releases/*.tar.gz
releases/*.zip
releases/*.exe
# Windows manifesti har qurishda yangi SHA bilan qayta yoziladi va u
# ta'riflaydigan `.exe` git'da yo'q — ya'ni yolg'iz manifestning ma'nosi
# ham yo'q.  (Linux `enes-sotqin-*.json` esa kuzatiladi: u reliz
# tarixining bir qismi.)
# Qoida ataylab BREND NOMISIZ: o'tish relizlari eski prefiks bilan chiqadi
# (`docs/RELIZ_VA_OTA.md`) va har reliz uchun bu yerga yangi qator qo'shish
# kerak bo'lardi.  Bir marta 0.6.30 shunday pinlangan edi va u brend
# qo'riqchisini (`tests/test_brand.py`) yiqitdi.
releases/*-windows-*.json

# Ma'lumotlar va modellar
data/
*.db
.insightface/

# Muhit
.env
.env.*
!.env.example
!.env.production.example

# Maxfiy kalitlar va lokal credential fayllari
.deploy_keys/
secrets/
*.pem
# OTA ochiq kaliti — ataylab commit qilinadi: u reliz paketi ichida
# qurilmaga boradi va o'rnatishda qotiriladi.  Maxfiy kalit esa repo
# daraxtidan tashqarida (~/.enes/), ya'ni bu yerga tushishi mumkin emas.
!deploy/update-public.pem
*.key
*.p12
*.pfx
config/secrets.yaml
config/secrets.yml

# Frontend (React v2 panel) — bog'liqliklar npm ci bilan tiklanadi
frontend/node_modules/

# Dizayn namunalari (rasm mockuplari) — repoga kirmaydi.  dizayn-3: ega bergan
# 5 ta PNG (~9 MB), saytga faqat kesilgan WebP nusxasi kiradi (cloud/static/).
Yangi dizayn-2/
dizayn-3/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Log va vaqtinchalik
*.log
/tmp/

# Agent worktree'lari — vaqtincha ish papkalari, loyihaga tegishli emas.
.claude/worktrees/
