FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-cloud.txt

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN groupadd --gid 10001 chaqimchi && useradd --uid 10001 --gid 10001 --no-create-home chaqimchi
COPY --from=builder /install /usr/local
COPY chaqimchi_ai ./chaqimchi_ai
COPY cloud ./cloud
COPY deploy ./deploy
RUN mkdir -p /app/data/cloud && chown -R chaqimchi:chaqimchi /app/data
USER 10001:10001
EXPOSE 8750
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8750/health',timeout=4)"
CMD ["uvicorn", "cloud.main:app", "--host", "0.0.0.0", "--port", "8750", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
