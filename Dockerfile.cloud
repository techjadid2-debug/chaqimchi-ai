FROM node:22-alpine AS frontend-builder
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ENV ENES_UI_OUT_DIR=/build/v2
RUN npm run build

FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements-cloud.txt

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
# libglib: opencv-python-headless'ning slim image'dagi yagona tizim bog'liqligi.
RUN apt-get update \
  && apt-get install -y --no-install-recommends libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 enes && useradd --uid 10001 --gid 10001 --no-create-home enes
COPY --from=builder /install /usr/local
COPY enes ./enes
COPY cloud ./cloud
# Til katalogi — `cloud/i18n.py` uni repo ILDIZIDAN o'qiydi.  Usiz
# konteynerdagi birinchi `t()` chaqiruvi FileNotFoundError beradi va
# har xato javobi 500 ga aylanadi.  F2 (2026-09-07) da katalog qo'shilgan,
# bu qator esa 2026-09-08 da sayt qurilishida topilib qo'shildi.
COPY i18n ./i18n
COPY --from=frontend-builder /build/v2 ./cloud/static/v2
COPY deploy ./deploy
COPY scripts ./scripts
# Model manifestlari (URL + sha256, og'irliklarsiz — jami ~12 KB).
# `fetch_face_models.py` konteyner ICHIDA ishlaydi va manifestsiz
# "topilmadi" deb to'xtaydi: model o'rnatib bo'lmaydi, davomat esa
# jimgina ishlamay qoladi.  Og'irliklar image'ga kirmaydi — ular
# `cloud_state` volumega yuklab olinadi.
COPY models ./models
RUN mkdir -p /app/data/cloud && chown -R enes:enes /app/data


USER 10001:10001
EXPOSE 8750
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8750/health',timeout=4)"
# Worker soni env'dan.  Standart — BITTA: ko'p worker faqat boshqaruv
# bazasi PostgreSQL'ga ko'chgandan keyin ma'noga ega (SQLite bitta faylga
# ko'p jarayondan yozishga yaramaydi) va `cloud/main.py` buni startupda
# tekshirib, shart bajarilmasa umuman ko'tarilmaydi.
#
# `sh -c` shakli ataylab: exec ro'yxatida `${...}` almashtirilmaydi va
# uvicorn "1" o'rniga so'zma-so'z `${ENES_CLOUD_WORKERS}` ni ko'rardi.
CMD ["sh", "-c", "exec uvicorn cloud.main:app --host 0.0.0.0 --port 8750 --workers ${ENES_CLOUD_WORKERS:-1} --proxy-headers --forwarded-allow-ips '*'"]
