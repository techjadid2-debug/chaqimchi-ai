{$ENES_DOMAIN} {
    encode zstd gzip
    reverse_proxy cloud:8750 {
        # Mijoz yuborgan X-Forwarded-For'ni ALMASHTIRAMIZ (qo'shmaymiz):
        # uvicorn `*` bilan eng chapdagi qiymatni oladi, ya'ni mijoz
        # o'zi yozgan manzil qabul qilinib, IP cheklovlari aylanib
        # o'tilardi.
        header_up X-Forwarded-For {remote_host}
    }
    # Statik fayllar keshi — sabab `Caddyfile.enes` dagi bilan bir
    # xil: `Cache-Control` yo'q bo'lsa brauzer har safar "o'zgardimi?"
    # deb so'rab chiqadi.
    @versioned {
        path /assets/*
        query v=*
    }
    header @versioned Cache-Control "public, max-age=31536000, immutable"

    @images path /assets/*.webp /assets/*.jpg /assets/*.png /assets/*.svg
    header @images Cache-Control "public, max-age=2592000"

    @other_assets {
        path /assets/*
        not query v=*
        not path /assets/*.webp /assets/*.jpg /assets/*.png /assets/*.svg
    }
    header @other_assets Cache-Control "public, max-age=300"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Siyosat `Caddyfile.enes` dagi bilan BIR XIL bo'lishi shart —
        # `tests/test_security_headers.py` tenglikni qulflaydi.  Sabab
        # eski tuzoq: `test_proxy_limits.py` uzoq vaqt faqat shu faylni
        # o'qib, productionda ishlatiladigan `Caddyfile.enes` ga umuman
        # qaramagan edi.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://telegram.org 'sha256-0GOmhbWvbvAgGk4AueWj7EVEA4P9l0+cO+8xcwykeec='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }
    # Klip limiti (cloud/main.py CLIP_MAX_BYTES = 50MB) dan katta bo'lishi
    # shart: 10MB paytida 15-22MB'lik hodisa kliplari proxy'da 413 bilan
    # qaytib, jimgina dead_letter'ga tushardi. tests/test_proxy_limits.py
    # bu ikkovi mosligini tekshiradi.
    request_body {
        max_size 60MB
    }
    log {
        output stdout
        format json
    }
}
