# ── Admin (faqat egasi) ──────────────────────────────────────────────────
admin.chaqimchi.uz {
	import security
	import noindex
	encode zstd gzip
	# Kelajakda VPN/IP cheklovi uchun tayyor joy (hozircha parol bilan):
	#   @tashqi not remote_ip 100.64.0.0/10 SIZNING_IP
	#   handle @tashqi { respond "Ruxsat yo'q" 403 }
	@allowed path / /admin /admin/* /assets/* /vendor/* /robots.txt /api/v1/admin/* /api/v1/auth/* /api/v1/public/urls /installer-guide
	handle @allowed {
		reverse_proxy cloud:8750 {
			# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
			# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
			# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
			# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
			# o'tilardi (sinov ro'yxati, kirish urinishlari).
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Topilmadi" 404
	}
	request_body {
		max_size 5MB
	}
}

# ── Yuklab olish (keyin CDN'ga DNS bilan ko'chadi) ───────────────────────
dl.chaqimchi.uz {
	import security
	import noindex
	encode zstd gzip
	@allowed path / /downloads/* /releases/* /install /assets/* /robots.txt /api/v1/public/*
	handle @allowed {
		reverse_proxy cloud:8750 {
			# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
			# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
			# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
			# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
			# o'tilardi (sinov ro'yxati, kirish urinishlari).
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Topilmadi" 404
	}
	request_body {
		max_size 1MB
	}
}

# ── Hujjatlar (SEO ochiq, statik) ────────────────────────────────────────
docs.chaqimchi.uz {
	import security
	encode zstd gzip
	@allowed path / /ornatish-windows /nvr-hikvision /nvr-dahua /nvr-uniview /muammolar /xavfsizlik /docs-static/* /assets/* /robots.txt
	handle @allowed {
		reverse_proxy cloud:8750 {
			# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
			# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
			# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
			# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
			# o'tilardi (sinov ro'yxati, kirish urinishlari).
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Topilmadi" 404
	}
	request_body {
		max_size 1MB
	}
}

# Eslatma: status.chaqimchi.uz bu serverga KELMAYDI — u tashqi xizmatda
# (UptimeRobot status page, DNS'da CNAME) — server o'lsa status tirik qoladi.
