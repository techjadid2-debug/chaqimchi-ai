# chaqimchi.uz platformasi — subdomen bo'yicha yo'l-ruxsatnomalar.
#
# Hamma subdomen BITTA cloud ilovasiga proxy bo'ladi; ajratish shu yerda:
# har host faqat o'z bo'limining yo'llarini o'tkazadi.  Panellar API'ni
# nisbiy yo'ldan chaqiradi — so'rov o'sha hostda qoladi, CORS kerak emas.
#
# Sertifikatlar: Caddy har host uchun Let's Encrypt'dan o'zi oladi —
# DNS'da A yozuvlar serverga ko'rsatib turgani yetarli.

# Umumiy xavfsizlik headerlari (import bilan har blokga qo'shiladi).
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	log {
		output stdout
		format json
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# Statik fayllar uchun kesh muddati.
#
# Bungacha `Cache-Control` HECH QAYERDA yo'q edi.  Starlette faqat `ETag`
# va `Last-Modified` qo'yadi, ya'ni brauzer har safar "o'zgardimi?" deb
# so'rab chiqardi: qayta kelgan mijoz uchun 14 ta bekorga borib-kelish.
# Toshkentdan Germaniyagacha bitta borib-kelish ~120 ms (o'lchandi).
#
# Uch xil muddat, chunki fayllar uch xil:
#   - `?v=<hash>` bor  → nomi mazmundan chiqadi, hech qachon o'zgarmaydi;
#   - rasm            → nomida `-v1`/`-v2` bor, yangisi yangi nom oladi;
#   - qolgani         → `owner.css`, `icons.svg` — versiyasiz, ya'ni
#                       tuzatish tez yetishi kerak.  5 daqiqa: seans
#                       ichidagi takror so'rovlarni yo'qotadi, lekin
#                       nosozlik tuzatilsa hamma darrov oladi.
(static_cache) {
	@versioned {
		path /assets/*
		query v=*
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@images path /assets/*.webp /assets/*.jpg /assets/*.png /assets/*.svg
	header @images Cache-Control "public, max-age=2592000"

	@other_assets {
		path /assets/*
		not query v=*
		not path /assets/*.webp /assets/*.jpg /assets/*.png /assets/*.svg
	}
	header @other_assets Cache-Control "public, max-age=300"
}

# ── Landing (marketing) ──────────────────────────────────────────────────
chaqimchi.uz {
	import security
	import static_cache
	encode zstd gzip
	# Landing + ochiq sahifalar + public API (lead, narx, pay callback).
	# Panellar bu yerdan subdomenlarga 301 bo'ladi (ilova ichida).
	reverse_proxy cloud:8750 {
		# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
		# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
		# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
		# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
		# o'tilardi (sinov ro'yxati, kirish urinishlari).
		header_up X-Forwarded-For {remote_host}
	}
	request_body {
		max_size 5MB
	}
}

www.chaqimchi.uz {
	import security
	import static_cache
	redir https://chaqimchi.uz{uri} permanent
}

# ── API: qurilmalar, to'lov, Telegram (ENG BARQAROR shartnoma) ──────────
api.chaqimchi.uz {
	import security
	import static_cache
	import noindex
	encode zstd gzip
	# `/health*` — `/health` dan tashqari `/health/deep` ham o'tsin:
	# tashqi monitoring (UptimeRobot) aynan chuqur tekshiruvga qaraydi,
	# `/health` esa ataylab bog'liqliklarga tegmaydi va doim 200 beradi.
	@allowed path /api/* /health* /releases/* /downloads/* /robots.txt
	handle @allowed {
		reverse_proxy cloud:8750 {
			# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
			# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
			# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
			# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
			# o'tilardi (sinov ro'yxati, kirish urinishlari).
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Topilmadi" 404
	}
	# Klip limiti (cloud/main.py CLIP_MAX_BYTES = 50MB) dan katta bo'lishi
	# shart — tests/test_proxy_limits.py mosligini tekshiradi.
	request_body {
		max_size 60MB
	}
}

# ── Mijoz paneli ─────────────────────────────────────────────────────────
app.chaqimchi.uz {
	import security
	import static_cache
	import noindex
	encode zstd gzip
	@allowed path / /owner /owner/* /assets/* /vendor/* /robots.txt /api/v1/owner/* /api/v1/owner* /api/v1/auth/* /api/v1/public/urls /api/v1/public/windows-release /pay/* /api/v1/invoices/* /api/v1/payments/*
	handle @allowed {
		reverse_proxy cloud:8750 {
			# Mijoz yuborgan X-Forwarded-For'ni QO'SHMAYMIZ, ALMASHTIRAMIZ.
			# Caddy standart holda qo'shadi, uvicorn esa `*` bilan eng
			# CHAPDAGI qiymatni oladi — ya'ni mijoz o'zi yozgan manzil
			# qabul qilinardi va IP bo'yicha barcha cheklovlar aylanib
			# o'tilardi (sinov ro'yxati, kirish urinishlari).
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond "Topilmadi" 404
	}
	request_body {
		max_size 5MB
	}
}

