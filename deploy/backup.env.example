# /etc/chaqimchi/backup.env — chaqimchi-backup.service o'qiydi.
# Nusxalagach: chmod 600 /etc/chaqimchi/backup.env
#
# DIQQAT: backup paroli .env.production'dagi sirlardan BOSHQA joyda
# saqlansin (parol menejeri).  Fayl va parol bir joyda yursa, shifrlash
# ma'nosini yo'qotadi.

CHAQIMCHI_BACKUP_DIR=/home/deploy/chaqimchi-backups
CHAQIMCHI_BACKUP_PASSWORD=GENERATE_UZUN_BACKUP_SECRET
CHAQIMCHI_ENV_FILE=.env.production
# Serverda haqiqatan ishlatilayotgan compose fayli bilan bir xil bo'lishi
# SHART.  Nomi noto'g'ri bo'lsa `docker compose exec` ishlab turgan
# konteynerni topa olmaydi, skript `set -e` bilan to'xtaydi va xizmatda
# `OnFailure=` yo'qligi uchun bu har kecha JIMGINA takrorlanadi.
CHAQIMCHI_COMPOSE_FILE=docker-compose.chaqimchi.yml

# ── Tashqi nusxa (juda tavsiya etiladi) ─────────────────────────────────
#
# Bularsiz zaxira FAQAT shu serverda yotadi.  Server yo'qolsa (provayder
# uzilishi, to'lov, disk) hisob-faktura, obuna va portal loginlari zaxira
# bilan birga ketadi.  Kunlik arxiv endi kichik (~50-200 MB) — bepul
# 10-15 GB lik ombor bir necha oyga yetadi.
#
# Ikki yo'l bor, ixtiyoriy ravishda ikkalasini ham yoqish mumkin.
#
# 1) Telegram — hisob ham, karta ham kerak emas (bot allaqachon bor).
#    Har kuni shifrlangan arxiv shaxsiy chatga tushadi.  Bot orqali fayl
#    chegarasi 50 MB, shuning uchun faqat BAZA arxivi yuboriladi; arxiv
#    kattalashsa skript ogohlantiradi va restic'ga o'tish kerak bo'ladi.
# CHAQIMCHI_BACKUP_TELEGRAM_TOKEN=
# CHAQIMCHI_BACKUP_TELEGRAM_CHAT_ID=
#
# 2) restic — to'g'ri yechim, tashqi ombor talab qiladi.
#    Misol (rclone orqali, bepul ombor):
#      RESTIC_REPOSITORY=rclone:zaxira:chaqimchi
#      RESTIC_PASSWORD=UZUN_BOSHQA_PAROL
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=

# ── Media zaxirasi ──────────────────────────────────────────────────────
#
# Rasm va kliplar kunlik arxivga KIRMAYDI (ular o'nlab GB).  Ular haftada
# bir marta alohida unit bilan olinadi:
#   deploy/chaqimchi-backup-media.service + .timer
# Qo'lda: ./scripts/backup_production.sh --media
