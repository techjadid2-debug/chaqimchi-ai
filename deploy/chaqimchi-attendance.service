[Unit]
Description=Chaqimchi Attendance Pilot (local Face ID)
After=network-online.target chaqimchi-sotqin.service
Wants=network-online.target

[Service]
Type=simple
User=chaqimchi
Group=chaqimchi
WorkingDirectory=/opt/chaqimchi/current
EnvironmentFile=/etc/chaqimchi/sotqin.env
Environment=CHAQIMCHI_SERVICE_MODE=attendance
ExecStart=/opt/chaqimchi/venv/bin/uvicorn webapp.main:app --host 127.0.0.1 --port 8743 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/chaqimchi/shared/data /opt/chaqimchi/shared/logs /opt/chaqimchi/shared/models
PrivateDevices=no
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
