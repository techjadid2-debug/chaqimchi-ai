# ENES Cloud media zaxirasi — rasm va kliplar (MinIO).
#
# Nega kunlikdan ajratilgan: media o'nlab GB.  Har kecha nusxalanib, arxiv
# 14 kun saqlanganda 96 GB server ikki-uch do'kondan keyin to'lardi.
# Yo'qotish narxi ham boshqa: bir haftalik klip yo'qolsa biznes ishlaydi,
# hisob-faktura va akkauntlar yo'qolsa — yo'q.
#
# O'rnatish (VPS'da, root):
#   cp deploy/enes-backup-media.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now enes-backup-media.timer
#   systemctl start enes-backup-media.service   # birinchi sinov darhol
#
# Tiklash: ./scripts/restore_production.sh --restore enes-media-<sana>.tar.gz.enc

[Unit]
Description=ENES Cloud haftalik media zaxirasi (MinIO)
Wants=docker.service
After=docker.service network-online.target
OnFailure=enes-backup-failed.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/enes
EnvironmentFile=/etc/enes/backup.env
ExecStart=/home/deploy/enes/scripts/backup_production.sh --media
# Ikki nusxa yetadi (8 kun ≈ oxirgi ikkita haftalik arxiv).  Media eng ko'p
# joy egallaydigan narsa — bu yerda ko'p saqlash diskni yeydi.
ExecStartPost=/usr/bin/find ${ENES_BACKUP_DIR} -name enes-media-*.tar.gz.enc -mtime +8 -delete
Nice=15
IOSchedulingClass=idle
