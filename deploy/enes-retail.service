[Unit]
Description=ENES Retail (do'kon analitikasi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=enes
Group=enes
# OpenVINO iGPU'da ishlashi uchun /dev/dri/renderD128 kerak. Bu guruhlarsiz
# drayver o'rnatilgan bo'lsa ham detektor jimgina CPU'ga tushadi.
SupplementaryGroups=render video
WorkingDirectory=/opt/enes/current
EnvironmentFile=/etc/enes/sotqin.env
# Konfig yo'li sotqin.env dagi ENES_CONFIG dan olinadi — yuz tanish
# xizmati bilan bitta fayl.
ExecStart=/opt/enes/venv/bin/python -m enes.retail.service \
    --base-dir /opt/enes/current
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/enes/shared/data /opt/enes/shared/logs
# ffmpeg segment yozuvchilari shu xizmatning bolalari — ular ham to'xtasin.
KillMode=control-group
PrivateDevices=no
UMask=0077
LimitNOFILE=65536
# Xotira shifti cgroup darajasida: `MemoryHigh` OOM-killer'dan oldin siqadi,
# `MemoryMax` esa o'ldiradi va `Restart=always` tiklaydi. Uch xizmat jami
# 6.1 GB — 8 GB qurilmada tizimga joy qoladi (talab: <= 6.5 GB).
MemoryHigh=2G
MemoryMax=2560M

[Install]
WantedBy=multi-user.target
