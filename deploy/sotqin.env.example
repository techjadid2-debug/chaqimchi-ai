ENES_CONFIG=/opt/enes/current/config/sotqin.yaml
ENES_CLOUD_URL=https://ai.example.uz
ENES_SITE_ID=FROM_PAIRING
ENES_DEVICE_ID=FROM_PAIRING
ENES_DEVICE_TOKEN=FROM_PAIRING
ENES_SOTQIN_MODEL=Intel N100
ENES_SOTQIN_REVISION=R1
ENES_SOTQIN_SERIAL=FROM_DEVICE
ENES_SOTQIN_HEARTBEAT_SEC=60
# Kamera uzilishi owner panel va soak-testda 5 daqiqadan kech ko'rinmasin.
ENES_CAMERA_PROBE_SEC=300
ENES_SOTQIN_CONFIG_CACHE=/opt/enes/shared/data/sotqin-config.json
ENES_RETAIL_OUTBOX=/opt/enes/shared/data/outbox.db
# Retail zanjiri kameralarning haqiqiy holatini shu faylga yozadi;
# Sotqin agenti uni heartbeat uchun o'qiydi (ffprobe emas).
ENES_RETAIL_STATUS=/opt/enes/shared/data/retail-status.json
ENES_ATTENDANCE_OUTBOX=/opt/enes/shared/data/attendance-outbox.db
ENES_API_KEY=GENERATE_AT_INSTALL
ENES_JWT_SECRET=GENERATE_AT_INSTALL
ENES_EMBEDDING_KEY=GENERATE_AT_INSTALL
# ENES_FACE_MODEL_LICENSED OLIB TASHLANDI (2026-08-21): modellar
# endi OpenVINO Open Model Zoo'dan, Apache-2.0 — litsenziya sozlamaga
# emas, koddagi faktga bog'liq (`cloud/faces.py`).
ENES_FACE_MODEL_MANIFEST=/opt/enes/shared/models/manifest.json
# Faqat yozma rozilikli, bepul yopiq pilotda true. Pullik rejimda tijoriy
# model manifesti tasdiqlanmasdan yoqilmaydi.
ENES_ATTENDANCE_PILOT=false
# Bu cloud sotuv darvozasi uchun; qurilmada faqat audit nusxasi bo'lishi mumkin.
ENES_N100_ACCEPTANCE_FILE=/opt/enes/acceptance/n100-r1.json
# RTSP manzillari bu faylda turmaydi: admin cloud orqali shifrlangan holda
# kiritadi, Sotqin esa pairingdan keyin HTTPS bilan oladi.
