CHAQIMCHI_CONFIG=/opt/chaqimchi/current/config/sotqin.yaml
CHAQIMCHI_CLOUD_URL=https://ai.example.uz
CHAQIMCHI_SITE_ID=FROM_PAIRING
CHAQIMCHI_DEVICE_ID=FROM_PAIRING
CHAQIMCHI_DEVICE_TOKEN=FROM_PAIRING
CHAQIMCHI_SOTQIN_MODEL=Intel N100
CHAQIMCHI_SOTQIN_REVISION=R1
CHAQIMCHI_SOTQIN_SERIAL=FROM_DEVICE
CHAQIMCHI_SOTQIN_HEARTBEAT_SEC=60
# Kamera uzilishi owner panel va soak-testda 5 daqiqadan kech ko'rinmasin.
CHAQIMCHI_CAMERA_PROBE_SEC=300
CHAQIMCHI_SOTQIN_CONFIG_CACHE=/opt/chaqimchi/shared/data/sotqin-config.json
CHAQIMCHI_RETAIL_OUTBOX=/opt/chaqimchi/shared/data/outbox.db
# Retail zanjiri kameralarning haqiqiy holatini shu faylga yozadi;
# Sotqin agenti uni heartbeat uchun o'qiydi (ffprobe emas).
CHAQIMCHI_RETAIL_STATUS=/opt/chaqimchi/shared/data/retail-status.json
CHAQIMCHI_ATTENDANCE_OUTBOX=/opt/chaqimchi/shared/data/attendance-outbox.db
CHAQIMCHI_API_KEY=GENERATE_AT_INSTALL
CHAQIMCHI_JWT_SECRET=GENERATE_AT_INSTALL
CHAQIMCHI_EMBEDDING_KEY=GENERATE_AT_INSTALL
# CHAQIMCHI_FACE_MODEL_LICENSED OLIB TASHLANDI (2026-08-21): modellar
# endi OpenVINO Open Model Zoo'dan, Apache-2.0 — litsenziya sozlamaga
# emas, koddagi faktga bog'liq (`cloud/faces.py`).
CHAQIMCHI_FACE_MODEL_MANIFEST=/opt/chaqimchi/shared/models/manifest.json
# Faqat yozma rozilikli, bepul yopiq pilotda true. Pullik rejimda tijoriy
# model manifesti tasdiqlanmasdan yoqilmaydi.
CHAQIMCHI_ATTENDANCE_PILOT=false
# Bu cloud sotuv darvozasi uchun; qurilmada faqat audit nusxasi bo'lishi mumkin.
CHAQIMCHI_N100_ACCEPTANCE_FILE=/opt/chaqimchi/acceptance/n100-r1.json
# RTSP manzillari bu faylda turmaydi: admin cloud orqali shifrlangan holda
# kiritadi, Sotqin esa pairingdan keyin HTTPS bilan oladi.
